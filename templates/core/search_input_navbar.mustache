{{!
    @template core/search_input_navbar

    Navbar search input template.

    Example context (json):
    {
        "action": "https://moodle.local/admin/search.php",
        "inputname": "search",
        "searchstring": "Search",
        "hiddenfields": [
            {
                "name": "cmid",
                "value": "11"
            }
        ]
    }
}}
{{!
    This template is a modified version of core/search_input_navbar

    Modifications compared to the original template (JKU navigation header,
    Figma node 11229:102372):
    * The search form is always visible as an inline input field instead of
      being collapsed behind a toggle icon.
    * The magnifier icon sits inside the field (as the submit button) on the
      left of the input.
    * The field is hidden on mobile viewports where there is no room for it.
    * The form submits to the JKU course offer page (angebot.php) with the
      wunderbyte_table wbtsearch parameter instead of the Moodle global
      search, so the context's action/inputname/hiddenfields are ignored.
}}
<div id="searchinput-navbar-{{uniqid}}" class="simplesearchform d-none d-md-flex">
    <form autocomplete="off" action="{{config.wwwroot}}/theme/boost_union_jku/angebot.php" method="get" accept-charset="utf-8" class="mform d-flex align-items-center searchform-navbar">
        <div class="input-group" {{#grouplabel}}role="group" aria-labelledby="searchgrouplabel-{{uniqid}}"{{/grouplabel}}>
            {{#grouplabel}}
                <span id="searchgrouplabel-{{uniqid}}" class="visually-hidden">{{{ . }}}</span>
            {{/grouplabel}}
            <button type="submit" class="btn btn-submit" data-action="submit" title="{{#str}}performsearch, search{{/str}}">
                {{#pix}} a/search, core {{/pix}}
                <span class="visually-hidden">{{#str}}performsearch, search{{/str}}</span>
            </button>
            <label for="searchinput-{{uniqid}}" class="visually-hidden">{{{ searchstring }}}</label>
            <input type="text"
                id="searchinput-{{uniqid}}"
                class="form-control"
                placeholder="{{{ searchstring }}}"
                aria-label="{{{ searchstring }}}"
                name="wbtsearch"
                data-region="input"
                autocomplete="off"
            >
        </div>
    </form>
</div>

{{#js}}
require([], function() {
    const form = document.querySelector('#searchinput-navbar-{{uniqid}} form');
    // The navbar renders this template a second time whose markup is
    // discarded; its js block still runs and must not throw.
    if (!form) {
        return;
    }
    const input = form.querySelector('[data-region="input"]');

    form.addEventListener('submit', (e) => {
        if (input.value.trim() === '') {
            e.preventDefault();
            input.focus();
        }
    });
});
{{/js}}
