{{!
    @template mod_booking/page_teacher

    Theme override for the JKU design: back link to the overview, profile
    header (round avatar, name, contact details, actions), description and
    the teacher's booking options grouped in JKU-styled tabs.

    Example context (json):
    {
        "teacher" : {
            "teacherid" : "1006",
            "firstname" : "Maxima",
            "lastname" : "Yoga",
            "description" : "description",
            "canedit" : "1",
            "optiontables" : [
                {
                    "bookingid" : "1",
                    "bookinginstancename" : "ws 22/23",
                    "tablename" : "ws",
                    "table" : "HTML of the table of teacher's booking options",
                    "class" : "active show"
                }
            ]
        },
        "linktoperformedunitsreport" : "http://site/mod/booking/teacher_performed_units_report.php?teacherid=1006",
        "wwwroot" : "http://site"
    }
}}
<div class="jku-teacherpage">
    <div class="jku-detail__inner">
        {{#error}}
        <div class="alert alert-danger mt-3" role="alert">{{{errormessage}}}</div>
        {{/error}}
        {{^error}}
        <div class="jku-detail__topbar">
            <a href="{{wwwroot}}/mod/booking/teachers.php" role="button" class="backtooverview jku-detail__back d-inline-flex align-items-center">
                <i class="fa-solid fa-arrow-left mr-2" aria-hidden="true"></i>
                {{#str}} backtooverview, theme_boost_union_jku {{/str}}
            </a>
        </div>
        {{#teacher}}
        <div class="jku-teacherpage__main">
            <div class="jku-teacherpage__header">
                <div class="jku-teacher__avatar">
                    {{#image}}<img src="{{.}}" alt="{{firstname}} {{lastname}}">{{/image}}
                    {{^image}}<span class="jku-teacher__avatar-placeholder"><i class="fas fa-user" aria-hidden="true"></i></span>{{/image}}
                </div>
                <div class="jku-teacherpage__headerinfo">
                    <h1 class="jku-teacherpage__name">
                        {{firstname}} {{lastname}}
                        {{#canedit}}
                        <a class="jku-teacherpage__edit edit-teacher-description" data-teacherid="{{teacherid}}" role="button" aria-label="{{#str}} edit, core {{/str}}" title="{{#str}} edit, core {{/str}}">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                        </a>
                        {{/canedit}}
                    </h1>
                    <div class="jku-teacherpage__meta">
                        {{#email}}
                        <a href="mailto:{{email}}" class="jku-teacherpage__metaitem page-teacher-email">
                            <i class="fa fa-envelope" aria-hidden="true"></i>{{email}}
                        </a>
                        {{/email}}
                        {{#phones}}
                        <a href="tel:{{.}}" id="phone-teacher-{{teacherid}}" class="jku-teacherpage__metaitem page-teacher-phone">
                            <i class="fa fa-phone" aria-hidden="true"></i>{{.}}
                        </a>
                        {{/phones}}
                    </div>
                    {{^messagesdeactivated}}{{#messagingispossible}}
                    <div class="jku-teacherpage__actions">
                        <a id="message-user-button" role="button" data-conversationid="0" data-userid="{{teacherid}}"
                            href="{{wwwroot}}/message/index.php?id={{teacherid}}" class="btn btn-secondary">
                            <i class="fa fa-comment-o mr-2" aria-hidden="true"></i>{{#str}} messagebutton, mod_booking {{/str}}
                        </a>
                        {{#linktoperformedunitsreport}}
                        <a href="{{.}}" class="btn btn-secondary" target="_self">
                            <i class="fa fa-clock-o mr-2" aria-hidden="true"></i>{{#str}} teacherhourslabel, mod_booking {{/str}}
                        </a>
                        {{/linktoperformedunitsreport}}
                    </div>
                    {{/messagingispossible}}{{/messagesdeactivated}}
                    {{#messagesdeactivated}}{{#linktoperformedunitsreport}}
                    <div class="jku-teacherpage__actions">
                        <a href="{{.}}" class="btn btn-secondary" target="_self">
                            <i class="fa fa-clock-o mr-2" aria-hidden="true"></i>{{#str}} teacherhourslabel, mod_booking {{/str}}
                        </a>
                    </div>
                    {{/linktoperformedunitsreport}}{{/messagesdeactivated}}
                </div>
            </div>
            {{#description}}
            <div class="jku-detail__section">
                <div class="jku-detail__text jku-teacherpage__description">{{{description}}}</div>
            </div>
            {{/description}}
            {{#optiontables.0}}
            <div class="jku-detail__section jku-teacherpage__courses">
                <h2 class="jku-detail__heading">{{#str}} showcoursesofteacher, mod_booking {{/str}}</h2>
                <nav class="w-100">
                    <ul class="nav jku-tabs" id="nav-tab" role="tablist">
                        {{#optiontables}}
                        <li class="nav-item">
                            <a class="nav-link {{class}}" id="nav-tab-{{tablename}}" data-toggle="tab" data-bs-toggle="tab"
                                href="#nav-table-{{tablename}}" role="tab" aria-controls="nav-table-{{tablename}}">
                                {{bookinginstancename}}
                            </a>
                        </li>
                        {{/optiontables}}
                    </ul>
                </nav>
                <div class="tab-content w-100" id="nav-tabContent">
                    {{#optiontables}}
                    <div class="tab-pane fade {{class}}" id="nav-table-{{tablename}}" role="tabpanel" aria-labelledby="nav-tab-{{tablename}}">{{{table}}}</div>
                    {{/optiontables}}
                </div>
            </div>
            {{/optiontables.0}}
        </div>
        {{/teacher}}
        {{/error}}
    </div>
</div>

{{#js}}
    require(['mod_booking/edit-teacher-description'], function(init) {
    init.init();
    });
{{/js}}
