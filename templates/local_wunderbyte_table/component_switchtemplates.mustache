{{!
    @template local_wunderbyte_table/component_switchtemplates

    JKU override of the wunderbyte table template switcher (Figma node
    11231-167862): a single square icon toggle. Every template is rendered as
    its own button, but post.scss hides the current view's button (.active), so
    only the button for the view you can switch TO is visible — one click always
    toggles to the other view.

    The switch is handled entirely by the JS block below (not by the generic
    actionbutton.js, hence no data-type="wb_action_button" here): it calls the
    switchtemplates action via the execute_action webservice and then reloads
    the table directly with init.callLoadData. We bypass reloadAllTables on
    purpose: its open-collapsible guard would skip the reload because the jku
    filter panel is a permanently open bootstrap collapse.

    IMPORTANT: never write mustache tags (double curly braces) inside these
    comment blocks -- a comment ends at the first closing double brace, so a tag
    here would spill the rest of the comment onto the page as literal text.

    Both view icons (list and grid) are output in every button; post.scss shows
    the one matching the button's data-selected-value prefix. This keeps the icon
    independent of viewparam, which JKU leaves at 0 for all templates.

    Example context (json):
    {
        "switchtemplates": [
            {
                "templates": [
                    {
                        "template": "local_jku/table_list",
                        "label": "List",
                        "viewparam": 0,
                        "selected": true
                    },
                    {
                        "template": "local_jku/table_card",
                        "label": "Cards",
                        "viewparam": 0
                    }
                ]
            }
        ]
    }
}}
{{#switchtemplates}}
<div class="wbtable-templateswitcher-container jku-templateswitcher-group me-3" role="group"
    aria-label="{{#str}} templateswitcherlabel, local_wunderbyte_table {{/str}}">
    {{#templates}}
    <button type="button"
        class="jku-templateswitcher-btn{{#selected}} active{{/selected}}"
        data-selected-value="{{template}} {{viewparam}}"
        aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
        title="{{label}}" aria-label="{{label}}">
        <span class="jku-templateswitcher-icon jku-templateswitcher-icon--list" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.33333 4H14M5.33333 8H14M5.33333 12H14M2 4H2.00667M2 8H2.00667M2 12H2.00667"
                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
        <span class="jku-templateswitcher-icon jku-templateswitcher-icon--cards" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="5.2" height="5.2" rx="1.3" stroke="currentColor" stroke-width="1.5"/>
                <rect x="8.8" y="2" width="5.2" height="5.2" rx="1.3" stroke="currentColor" stroke-width="1.5"/>
                <rect x="2" y="8.8" width="5.2" height="5.2" rx="1.3" stroke="currentColor" stroke-width="1.5"/>
                <rect x="8.8" y="8.8" width="5.2" height="5.2" rx="1.3" stroke="currentColor" stroke-width="1.5"/>
            </svg>
        </span>
        <span class="sr-only">{{label}}</span>
    </button>
    {{/templates}}
</div>
{{#js}}
require(['core/ajax', 'local_wunderbyte_table/init'], function(Ajax, Init) {
    document.querySelectorAll('.jku-templateswitcher-group').forEach(function(group) {
        if (group.dataset.jkuSwitcherInit) {
            return;
        }
        group.dataset.jkuSwitcherInit = '1';

        // Resolve the table this switcher belongs to.
        var container = group.closest('[class*="wunderbyte_table_container_"]');
        if (!container) {
            return;
        }
        var idstring = '';
        container.classList.forEach(function(c) {
            if (c.indexOf('wunderbyte_table_container_') === 0) {
                idstring = c.replace('wunderbyte_table_container_', '');
            }
        });

        group.addEventListener('click', function(e) {
            var btn = e.target.closest('.jku-templateswitcher-btn');
            if (!btn || btn.classList.contains('active')) {
                return;
            }
            var tableel = document.getElementById('a' + idstring);
            var encodedtable = (tableel && tableel.dataset.encodedtable) ||
                container.dataset.encodedtable || '';
            if (!encodedtable) {
                return;
            }
            Ajax.call([{
                methodname: 'local_wunderbyte_table_execute_action',
                args: {
                    id: 1,
                    methodname: 'switchtemplates',
                    data: JSON.stringify({selectedValue: btn.dataset.selectedValue}),
                    encodedtable: encodedtable
                },
                done: function(res) {
                    if (res.success != 1) {
                        window.console.log('switchtemplates failed', res);
                        return;
                    }
                    // Flip the toggle: hide the now-current view's button,
                    // show the other one.
                    group.querySelectorAll('.jku-templateswitcher-btn').forEach(function(b) {
                        b.classList.toggle('active', b === btn);
                        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
                    });
                    // Re-render this table with the newly chosen template.
                    Init.callLoadData(idstring, encodedtable);
                },
                fail: function(ex) {
                    window.console.log('switchtemplates error', ex);
                }
            }]);
        });
    });
});
{{/js}}
{{/switchtemplates}}
